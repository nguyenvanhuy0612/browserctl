{
  "name": "browserctl",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Browser control for AI agents in the user's real Chrome, through an MV3 extension and a local daemon.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "browserctl": "src/cli/main.js",
    "browserctl-mcp": "src/mcp/main.js"
  },
  "scripts": {
    "build": "node scripts/build-extension.js",
    "test": "node --test tests/unit/*.test.js",
    "test:live": "node --test --test-concurrency=1 tests/live/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "daemon": "node src/daemon/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "playwright-core": "1.65.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}

{
  "manifest_version": 3,
  "name": "browserctl",
  "version": "1.0.0",
  "description": "Lets AI agents operate web pages in this browser through the local browserctl daemon.",
  "minimum_chrome_version": "135",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "userScripts",
    "alarms",
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw/main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "runtime/dialog-shim.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "browserctl",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
